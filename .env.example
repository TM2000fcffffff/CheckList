# 도움말 챗봇 환경 변수 예시
# 복사해서 .env로 저장한 뒤 값을 채웁니다. .env는 커밋하지 않습니다.
# 챗봇은 Supabase Edge Function(supabase/functions/chatbot)에서 돌아갑니다.

# 아래 키는 Supabase 대시보드 > Edge Functions > Secrets에 등록해야 챗봇이 동작합니다(이 파일은 기록용).
# OpenAI: 답변 생성
OPENAI_API_KEY=
# 비우면 gpt-5-mini
OPENAI_MODEL=gpt-5-mini

# Upstage: 문서·질문 임베딩(embedding-passage / embedding-query, 4096차원)
UPSTAGE_API_KEY=
# 챗봇이 답변 근거로 읽을 문서
CHATBOT_DOC_PATH=docs/사용법.md

# Supabase (sync.js와 같은 값. 공개 키라 노출돼도 RLS로 보호됨)
SUPABASE_URL=https://jyrcxrpbrdvxppbdzgvd.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_5ZooqVpOwASLntgdG3FHSQ_BhtSLT6D
